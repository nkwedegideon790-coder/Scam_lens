# ---------- AI provider ----------
# Which provider to use: "anthropic" or "openai" (any OpenAI-compatible API).
SCAMLENS_AI_PROVIDER=anthropic

# Anthropic (default)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI-compatible (OpenAI, Groq, OpenRouter, Together, local servers...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Set to 0 if your OpenAI-compatible server does not support JSON mode.
OPENAI_JSON_MODE=1

# Sampling temperature sent to the model. Leave empty to omit the parameter.
AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=45

# ---------- Backend ----------
SCAMLENS_DB_PATH=data/scamlens.db
SCAMLENS_MAX_TEXT_CHARS=8000
SCAMLENS_MAX_IMAGE_MB=8
SCAMLENS_MAX_FILE_MB=1
# Requests per minute per client IP for analysis endpoints (0 disables).
SCAMLENS_RATE_LIMIT_PER_MIN=20
# Optional shared secret. If set, the backend requires an X-API-Key header
# and the Streamlit frontend must be configured with the same value.
SCAMLENS_API_TOKEN=
# Set to 1 only when running behind a trusted reverse proxy (uses X-Forwarded-For).
SCAMLENS_TRUST_PROXY=0
# Comma-separated list of browser origins allowed to call the API (usually empty).
SCAMLENS_CORS_ORIGINS=
SCAMLENS_OCR_LANG=eng
SCAMLENS_LOG_LEVEL=INFO

# ---------- Frontend ----------
SCAMLENS_API_URL=http://localhost:8000
